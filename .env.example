# Copy to .env.local. Every key is optional — with none set, the "mock" provider
# runs the full pipeline offline so you can develop the product without spending money.

# --- Serverless GPU (pay per second, no infra to run) ---
# https://fal.ai/dashboard/keys
FAL_KEY=

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Self-hosted ComfyUI (cheapest per clip once you have volume) ---
# Point at a ComfyUI instance on RunPod / Vast / your own box, e.g. http://127.0.0.1:8188
COMFY_URL=
# Optional bearer token if you put an auth proxy in front of it
COMFY_TOKEN=

# Which provider to use when the client doesn't specify one.
# mock | fal | replicate | comfy
DEFAULT_PROVIDER=mock
