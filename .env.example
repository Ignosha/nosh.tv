# --- Business the agent answers for (one deployment per client) ---
BUSINESS_NAME="Bright Smile Dental"
# What the business offers, prices, policies — the agent only answers from this text.
BUSINESS_INFO="General dentistry. Services: cleaning ($120, 60 min), whitening consult (free, 30 min). Located at 12 Main St. Accepts Delta Dental and Cigna."
BUSINESS_TIMEZONE="America/New_York"
# Days: mon tue wed thu fri sat sun. Separate blocks with ';'.
BUSINESS_HOURS="mon-fri 09:00-17:00; sat 10:00-14:00"
APPOINTMENT_MINUTES=30
# How many days ahead leads may book, and minimum notice in hours.
BOOKING_WINDOW_DAYS=14
MIN_NOTICE_HOURS=2

# --- Gemini (free tier key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google Calendar (OAuth client from Google Cloud Console; run `npm run google-token`) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Supabase (free project; run supabase/schema.sql in the SQL editor) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard at /admin (HTTP basic auth, user "admin") ---
ADMIN_PASSWORD=
