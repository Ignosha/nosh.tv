# Supabase (free tier). Stores intake requests. Server-only: never expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin (user "admin").
ADMIN_PASSWORD=

# Shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Stripe Payment Links (create them free in the Stripe dashboard; Stripe charges per payment).
# When set, the matching package button goes straight to checkout. When empty, it opens a case instead.
NEXT_PUBLIC_PAY_REPORT=
NEXT_PUBLIC_PAY_RECOVERY=
NEXT_PUBLIC_PAY_PLAN=
NEXT_PUBLIC_PAY_PARTNER=
