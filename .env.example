# ---- Required ----
# Supabase (free tier). Server-only: never expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin (user "admin").
ADMIN_PASSWORD=
# Public address of the site, used in case links and emails.
NEXT_PUBLIC_SITE_URL=https://tracesworn.com

# ---- Payments (Stripe) ----
# Payment links are already built in (src/lib/pricing.ts). This secret lets the site mark cases paid.
STRIPE_WEBHOOK_SECRET=
# Optional overrides for any payment link:
NEXT_PUBLIC_PAY_REPORT=
NEXT_PUBLIC_PAY_RECOVERY=
NEXT_PUBLIC_PAY_COMPLEX=
NEXT_PUBLIC_PAY_PARTNER=

# ---- Automation ----
# Protects the daily follow-up job (Vercel Cron sends it automatically).
CRON_SECRET=
# Your name, used to sign scripts and emails.
OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Optional: AI (Google Gemini, free tier) ----
# Turns on the homepage chat and AI-polished report summaries. Without it, templates are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Optional: sending email (Resend, free tier 3,000/month) ----
# Without these, the admin opens emails in your mail app instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=TraceSworn <cases@tracesworn.com>
EMAIL_REPLY_TO=
# Where asset-movement alerts are copied (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
ALERT_EMAIL=

# ---- Client finder & outreach ----
# Free CourtListener API token (courtlistener.com → profile → API) to find counsel in crypto cases.
COURTLISTENER_TOKEN=
# Outreach only sends when all three are set: Resend above, your postal address (CAN-SPAM), and the switch.
BUSINESS_ADDRESS=
OUTREACH_ENABLED=0
OUTREACH_DAILY_LIMIT=10

# Verified $10,000/month Firm Premier checkout, optional until configured
NEXT_PUBLIC_PAY_PREMIER=

# Loaded internal labor cost for contribution estimates, USD/hour
INTERNAL_HOURLY_COST=125
# A reachable monitored reply mailbox is required for outreach
# Stop sequences manually when replies arrive; no inbound-email automation is configured.

# Consolidated daily review / exceptions digest
OPS_EMAIL=

# ---- Company production deployment (separate from the legacy service deployment) ----
# Set 1 to disable legacy admin, bearer portals, intake and old crons.
ENTERPRISE_MODE=0
# Bare HTTPS production origin. Use http://localhost:PORT only for local auth testing.
APP_ORIGIN=
# Public/publishable Supabase key for individual user sessions; NEVER use the service-role key.
SUPABASE_ANON_KEY=
# IMPORTANT: Omit SUPABASE_SERVICE_ROLE_KEY entirely from enterprise WEB deployments.
# Provisioning/contract/backup tools run in a separate trusted operations environment.
